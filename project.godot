; Engine configuration file.
; Godot 4.4 car driving simulator
config_version=5

[application]

config/name="Car Simulator Android"
config/description="3D car driving simulator for Android with touch controls"
config/version="1.3.3-android"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.4", "Mobile")
config/icon="res://icon.svg"

[autoload]

TouchInput="*res://scripts/touch_input.gd"

[audio]

buses/default_bus_layout="res://default_bus_layout.tres"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0
window/vsync/vsync_mode=1

[input]

